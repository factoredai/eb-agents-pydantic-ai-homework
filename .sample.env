# shellcheck shell=sh disable=SC2034

# Define the game id
TEYUNA_RULEBOOK=teyuna/docs/rulebook.md
TEYUNA_HOWTO=teyuna/docs/howto.md



# Define one based on your LLM provider
# TEYUNA_OPENAI_API_KEY=sk-...
# TEYUNA_OPENAI_MODEL_ID=gpt-4o

# Or Anthropic:
# TEYUNA_ANTHROPIC_API_KEY=...
# TEYUNA_ANTHROPIC_MODEL_ID=claude-sonnet-4-5

# Or AWS Bedrock:
TEYUNA_BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# Or a local Ollama model:
# TEYUNA_OLLAMA_MODEL_ID=llama3.2
# TEYUNA_OLLAMA_BASE_URL=http://localhost:11434/v1


# Server settings

TEYUNA_LOBBY_TIMEOUT=PT60S
TEYUNA_FIRST_PLACEMENT_TIMEOUT=PT60S
TEYUNA_SECOND_PLACEMENT_TIMEOUT=PT60S
TEYUNA_DICE_ROLL_TIMEOUT=PT60S
TEYUNA_DISCARD_RESOURCES_TIMEOUT=PT15S
TEYUNA_MOVE_CONQUISTATOR_TIMEOUT=PT15S
TEYUNA_DICE_PLAY_WARRIOR_TIMEOUT=PT15S
TEYUNA_DICE_PLAY_MAMO_TIMEOUT=PT15S
TEYUNA_DICE_PLAY_BLESSED_TIMEOUT=PT15S
TEYUNA_DICE_PLAY_PATHFINDER_TIMEOUT=PT15S
TEYUNA_TRADE_AND_BUILD_TIMEOUT=PT60S
TEYUNA_TRADE_AND_BUILD_PLAY_WARRIOR_TIMEOUT=PT60S
TEYUNA_TRADE_AND_BUILD_PLAY_MAMO_TIMEOUT=PT60S
TEYUNA_TRADE_AND_BUILD_PLAY_BLESSED_TIMEOUT=PT60S
TEYUNA_TRADE_AND_BUILD_PLAY_PATHFINDER_TIMEOUT=PT60S